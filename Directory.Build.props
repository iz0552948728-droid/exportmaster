<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NeutralLanguage>ru-RU</NeutralLanguage>
  </PropertyGroup>

  <!-- Ядро остаётся кроссплатформенным: п. 4.9 ТЗ допускает Linux.
       Windows-only API появятся только в проекте диалогового режима. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'ExportMaster.Gui'">
    <EnableWindowsTargeting>false</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
